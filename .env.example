# Example environment configuration for Tari Ootle Liquidity Protocol
# These values are PUBLIC and safe to share. No secrets should be placed here.

# Network selection (default: esmeralda for testnet)
# NETWORK=esmeralda

# Indexer URL configuration (public endpoints only)
# PRIMARY_INDEXER=https://indexer.esmeralda.tari.com
# FALLBACK_INDEXER=https://indexer-fallback.tari.com

# Feature flags (0 = disabled, 1 = enabled)
# ENABLE_STEALTH_ROUTE=0
# ENABLE_STABLECOIN_ROUTE=0
# ENABLE_NFT_ROUTE=0

# Development settings
# DEV_MODE=true
# WALLET_DAEMON_URL=http://localhost:5100/json_rpc
